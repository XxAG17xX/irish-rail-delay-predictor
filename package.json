{
  "name": "railcast-site",
  "private": true,
  "version": "1.0.0",
  "description": "Static site for RailCast. Tailwind is compiled ahead of time; the deploy stays a file copy.",
  "scripts": {
    "css": "tailwindcss -i styles/app.css -o site/app.css --minify",
    "css:watch": "tailwindcss -i styles/app.css -o site/app.css --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run css && npm run typecheck",
    "dev": "python scripts/dev_site.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
